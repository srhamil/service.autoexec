            <step>1</step>
            <maximum>60</maximum>
          </constraints>
          <control type="slider" format="integer">
            <popup>false</popup>
          </control>
        </setting>
        <setting id="skip_if_playing" type="boolean" label="30023" help="30024">
          <level>0</level>
          <default>true</default>

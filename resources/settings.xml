<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<settings version="1">
  <section id="service.autoexec">
    <category id="general" label="30000" help="">
      <group id="1">
        <setting id="enabled" type="boolean" label="30001" help="30002">
          <level>0</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
        <setting id="mode" type="integer" label="30003" help="30004">
          <level>0</level>
          <default>0</default>
          <constraints>
            <options>
              <option label="30010">0</option>
              <option label="30011">1</option>
              <option label="30012">2</option>
              <option label="30013">3</option>
            </options>
          </constraints>
          <control type="list" format="string"/>
        </setting>
        <setting id="playlist" type="path" label="30005" help="30006">
          <level>0</level>
          <default/>
          <constraints>
            <allowempty>true</allowempty>
            <writable>false</writable>
            <masking>.m3u|.m3u8</masking>
          </constraints>
          <dependencies>
            <dependency type="visible">
              <condition operator="!is" setting="mode">3</condition>
            </dependency>
          </dependencies>
          <control type="button" format="file">
            <heading>30005</heading>
          </control>
        </setting>
        <setting id="folder" type="path" label="30007" help="30008">
          <level>0</level>
          <default/>
          <constraints>
            <allowempty>true</allowempty>
            <writable>false</writable>
          </constraints>
          <dependencies>
            <dependency type="visible">
              <condition operator="is" setting="mode">3</condition>
            </dependency>
          </dependencies>
          <control type="button" format="path">
            <heading>30007</heading>
          </control>
        </setting>
      </group>
      <group id="2" label="30020">
        <setting id="delay" type="integer" label="30021" help="30022">
